        end
        Tween(arrowSt, { Color = C.White }, 0.15)
        Tween(arrowIcon, { ImageColor3 = C.White }, 0.15)
    end)

    btn.MouseButton1Click:Connect(function()
        Tween(btn, { BackgroundColor3 = C.White }, 0.05)
        task.delay(0.12, function()
            Tween(btn, { BackgroundColor3 = C.Black }, 0.15)
            Tween(labelLbl, { TextColor3 = C.White }, 0.15)
        end)
        task.spawn(function() pcall(callback) end)
    end)
end

