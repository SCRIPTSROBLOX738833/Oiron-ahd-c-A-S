-- ============ AUTO RESPONSIVE SCALE ============
local function updateScale()
    local vp = Camera.ViewportSize
    -- الحجم المناسب حسب أصغر بُعد في الشاشة
    -- نحسب على أساس الطول (لأن الموبايل بالعرض)
    local targetW = vp.X * 0.85
    local targetH = vp.Y * 0.85
    local scaleW = targetW / BASE_W
    local scaleH = targetH / BASE_H
    local scale = math.min(scaleW, scaleH)
    -- نحدد الحد الأدنى والأقصى
    scale = math.clamp(scale, 0.65, 1.4)
    UIScale.Scale = scale
end
updateScale()
Camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

function redzlib:SetScale(value)
    -- Manual override
    UIScale.Scale = value or 1
    -- نوقف الأوتو
    Camera:GetPropertyChangedSignal("ViewportSize"):Disconnect()
end

-- ============ NOTIFY ============
local notifyHolder
function redzlib:MakeNotify(a, b)
    local opts = b or a
    if type(opts) ~= "table" then opts = {} end
    local title    = opts.Title or "Notification"
    local content  = opts.Content or ""
    local duration = opts.Duration or 5

    if not notifyHolder or not notifyHolder.Parent then
        notifyHolder = Create("Frame", {
            Name = "NotifyHolder",
            Size = UDim2.new(0, 300, 1, -30),
            Position = UDim2.new(1, -320, 0, 15),
            BackgroundTransparency = 1,
            Parent = ScreenGui
        })
        Create("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = notifyHolder
        })
    end

    local notify = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = C.Black,
        LayoutOrder = math.floor(tick() * 1000) % 1000000,
        Parent = notifyHolder
    })
    Corner(notify, UDim.new(0, 8))
    Stroke(notify, C.White, 1.2)

    Create("Frame", {
        Size = UDim2.new(0, 3, 0.7, 0),
        Position = UDim2.new(0, 0, 0.15, 0),
        BackgroundColor3 = C.White,
        Parent = notify
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 18),
        Position = UDim2.new(0, 14, 0, 8),
        BackgroundTransparency = 1, Text = title,
        Font = Enum.Font.GothamBold, TextSize = 13,
        TextColor3 = C.White,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notify
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 26),
        Position = UDim2.new(0, 14, 0, 28),
        BackgroundTransparency = 1, Text = content,
        Font = Enum.Font.Gotham, TextSize = 10,
        TextColor3 = C.DimText,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Parent = notify
    })

    notify.Position = UDim2.new(1, 20, 0, 0)
    Tween(notify, { Position = UDim2.new(0, 0, 0, 0) }, 0.3, Enum.EasingStyle.Quint)

    task.spawn(function()
        task.wait(duration)
        Tween(notify, { Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1 }, 0.3)
        for _, c in ipairs(notify:GetDescendants()) do
            if c:IsA("TextLabel") then Tween(c, { TextTransparency = 1 }, 0.3) end
            if c:IsA("UIStroke") then Tween(c, { Transparency = 1 }, 0.3) end
            if c:IsA("Frame") then Tween(c, { BackgroundTransparency = 1 }, 0.3) end
        end
        task.wait(0.4)
        notify:Destroy()
    end)
end

