local Window = {}
Window.__index = Window

function Window:SelectTab(name)
    for _, t in ipairs(self.Tabs) do
        if t.Name == name then
            Tween(t.Button, { BackgroundColor3 = C.White }, 0.15)
            Tween(t.Stroke, { Transparency = 1 }, 0.15)
            t.Label.TextColor3 = C.Black
            t.Icon.ImageColor3 = C.Black
            t.Page.Visible = true
        else
            Tween(t.Button, { BackgroundColor3 = C.Black }, 0.15)
            Tween(t.Stroke, { Transparency = 0 }, 0.15)
            t.Label.TextColor3 = C.White
            t.Icon.ImageColor3 = C.White
            t.Page.Visible = false
        end
    end
end

function Window:Save()
    local data = {}
    for k, v in pairs(self.Flags) do data[k] = v end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if ok and writefile then pcall(writefile, self.SaveFolder, encoded) end
end

function Window:Load()
    if not (isfile and isfile(self.SaveFolder)) then return end
    local ok, content = pcall(readfile, self.SaveFolder)
    if not ok or not content then return end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or type(decoded) ~= "table" then return end
    for k, v in pairs(decoded) do self.Flags[k] = v end
end

