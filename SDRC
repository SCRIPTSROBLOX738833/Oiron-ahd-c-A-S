		Image = icon,
		BackgroundTransparency = 1,
		ImageColor3 = Color3.fromRGB(255, 255, 255)
	})

	Create("TextLabel", ToggleBtn, {
		Size = UDim2.new(1, -80, 1, 0),
		Position = UDim2.new(0, 40, 0, 0),
		Text = name,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 1,
		TextXAlignment = "Left"
	})

	-- Toggle Switch
	local SwitchHolder = Create("Frame", ToggleBtn, {
		Size = UDim2.new(0, 34, 0, 18),
		Position = UDim2.new(1, -15, 0.5, -9),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0
	})
	Make("Corner", SwitchHolder, UDim.new(0.5, 0))
	Make("Stroke", SwitchHolder, nil, Color3.fromRGB(255, 255, 255), 1)
	
	local Switch = Create("Frame", SwitchHolder, {
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new(0, 3, 0.5, -6),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 1
	})
	Make("Corner", Switch, UDim.new(0.5, 0))
	Make("Stroke", Switch, nil, Color3.fromRGB(255, 255, 255), 1)

	local state = default
	local function updateVisual()
		if state then
			TweenService:Create(Switch, TweenInfo.new(0.2), {Position = UDim2.new(1, -15, 0.5, -6), BackgroundTransparency = 0}):Play()
		else
			TweenService:Create(Switch, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -6), BackgroundTransparency = 1}):Play()
		end
	end
	updateVisual()

	ToggleBtn.MouseButton1Click:Connect(function()
		state = not state
		updateVisual()
		if callback then callback(state) end
	end)
end

