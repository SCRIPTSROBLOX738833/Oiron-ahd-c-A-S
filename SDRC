        Parent = frame
    })
    Corner(sliderBg, UDim.new(1, 0))
    Stroke(sliderBg, C.White, 1)

    local alpha = (value - min) / (max - min)
    local fill = Create("Frame", {
        Size = UDim2.new(alpha, 0, 1, 0),
        BackgroundColor3 = C.White,
        Parent = sliderBg
    })
    Corner(fill, UDim.new(1, 0))

    local knob = Create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(alpha, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = C.White,
        Parent = sliderBg
    })
    Corner(knob, UDim.new(1, 0))
    Stroke(knob, C.Black, 1.2)

    local dragging = false
    local function updateValue(input)
        local bgPos = sliderBg.AbsolutePosition.X
        local bgSize = sliderBg.AbsoluteSize.X
        local rel = math.clamp((input.Position.X - bgPos) / bgSize, 0, 1)
        local newValue = min + (max - min) * rel
        newValue = math.floor(newValue / inc + 0.5) * inc
        newValue = math.clamp(newValue, min, max)
        value = newValue
        valueLbl.Text = tostring(value)
        local a = (value - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        window.Flags[name] = value
        task.spawn(function() pcall(callback, value) end)
    end

    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateValue(input)
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            updateValue(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                window:Save()
            end
        end
    end)

    window.Flags[name] = value
end

-- ==========================================
-- TEXT INPUT
-- ==========================================
function Tab:AddInput(opts)
    opts = opts or {}
    local name         = opts.Name or "Input"
    local desc         = opts.Description or ""
    local default      = opts.Default or ""
    local placeholder  = opts.Placeholder or "Type..."
    local callback     = opts.Callback or function() end
    local clearOnEnter = opts.ClearOnEnter or false
    local window       = self.Window
    local saved        = window.Flags[name]
    local initial      = (saved ~= nil) and saved or default

    local height = (desc ~= "") and 54 or 44
    local frame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = C.Black,
        LayoutOrder = self:_nextOrder(),
        Parent = self.Page
    })
    Corner(frame, UDim.new(0, 7))
    Stroke(frame, C.White, 1)

    Create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 16),
        Position = UDim2.new(0, 14, 0, 6),
        BackgroundTransparency = 1,
        Text = name,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = C.White,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame
    })

    if desc ~= "" then
        Create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 12),
            Position = UDim2.new(0, 14, 0, 22),
            BackgroundTransparency = 1,
            Text = desc,
            Font = Enum.Font.Gotham,
            TextSize = 9,
            TextColor3 = C.DimText,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = frame
        })
    end

    local inputY = (desc ~= "") and 36 or 26
    local inputBox = Create("Frame", {
        Size = UDim2.new(1, -28, 0, height - inputY - 6),
        Position = UDim2.new(0, 14, 0, inputY),
        BackgroundColor3 = C.Black,
        Parent = frame
    })
    Corner(inputBox, UDim.new(0, 6))
    local inputSt = Stroke(inputBox, C.White, 1)

    local textBox = Create("TextBox", {
        Size = UDim2.new(1, -18, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = initial,
        PlaceholderText = placeholder,
        PlaceholderColor3 = C.DimText,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = C.White,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        Parent = inputBox
    })

    textBox.Focused:Connect(function()
        Tween(inputSt, { Thickness = 1.6 }, 0.15)
    end)
    textBox.FocusLost:Connect(function(enterPressed)
        Tween(inputSt, { Thickness = 1 }, 0.15)
        window.Flags[name] = textBox.Text
        task.spawn(function() pcall(callback, textBox.Text, enterPressed) end)
        if clearOnEnter and enterPressed then textBox.Text = "" end
        window:Save()
    end)

    window.Flags[name] = initial
end

-- ==========================================
-- DROPDOWN
-- ==========================================
function Tab:AddDropdown(opts)
    opts = opts or {}
    local name     = opts.Name or "Dropdown"
    local options  = opts.Options or {}
    local default  = opts.Default
    local callback = opts.Callback or function() end
    local window   = self.Window
    local saved    = window.Flags[name]
    local current  = (saved ~= nil) and saved or default

    local container = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        ClipsDescendants = false,
        LayoutOrder = self:_nextOrder(),
        Parent = self.Page
    })

    local frame = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = C.Black,
        Text = "",
        AutoButtonColor = false,
        Parent = container
    })
    Corner(frame, UDim.new(0, 7))
    Stroke(frame, C.White, 1)

    Create("TextLabel", {
        Size = UDim2.new(1, -120, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = C.White,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame
    })
    local currentLbl = Create("TextLabel", {
        Size = UDim2.new(0, 90, 1, 0),
        Position = UDim2.new(1, -105, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(current or "Select"),
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextColor3 = C.DimText,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame
    })

    local listHolder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 36),
        BackgroundColor3 = C.Black,
        Visible = false,
        ClipsDescendants = true,
        ZIndex = 5,
        Parent = container
    })
    Corner(listHolder, UDim.new(0, 7))
    Stroke(listHolder, C.White, 1)
    Create("UIListLayout", {
        Padding = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = listHolder
    })
    Create("UIPadding", {
        PaddingTop = UDim.new(0, 5),
        PaddingBottom = UDim.new(0, 5),
        PaddingLeft = UDim.new(0, 5),
        PaddingRight = UDim.new(0, 5),
        Parent = listHolder
    })

    local isOpen = false

    local function populate(opts2)
        for _, c in ipairs(listHolder:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for i, option in ipairs(opts2) do
            local optBtn = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundColor3 = C.Black,
                Text = tostring(option),
                Font = Enum.Font.Gotham,
                TextSize = 10,
                TextColor3 = C.White,
                AutoButtonColor = false,
                LayoutOrder = i,
                Parent = listHolder
            })
            Corner(optBtn, UDim.new(0, 5))
            Stroke(optBtn, C.White, 1).Transparency = 0.7
            optBtn.MouseEnter:Connect(function()
                Tween(optBtn, { BackgroundColor3 = C.White }, 0.1)
                Tween(optBtn, { TextColor3 = C.Black }, 0.1)
            end)
            optBtn.MouseLeave:Connect(function()
                Tween(optBtn, { BackgroundColor3 = C.Black }, 0.1)
                Tween(optBtn, { TextColor3 = C.White }, 0.1)
            end)
            optBtn.MouseButton1Click:Connect(function()
                current = tostring(option)
                currentLbl.Text = current
                window.Flags[name] = current
                task.spawn(function() pcall(callback, current) end)
                isOpen = false
                Tween(listHolder, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
                Tween(container, { Size = UDim2.new(1, 0, 0, 32) }, 0.15)
                task.delay(0.15, function()
                    if not isOpen then listHolder.Visible = false end
                end)
                window:Save()
            end)
        end
    end
    populate(options)

    frame.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            listHolder.Visible = true
            local targetH = math.min(#options * 27 + 12, 130)
            Tween(listHolder, { Size = UDim2.new(1, 0, 0, targetH) }, 0.18)
            Tween(container, { Size = UDim2.new(1, 0, 0, 36 + targetH) }, 0.18)
        else
            Tween(listHolder, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
            Tween(container, { Size = UDim2.new(1, 0, 0, 32) }, 0.15)
            task.delay(0.15, function()
                if not isOpen then listHolder.Visible = false end
            end)
        end
    end)

    return {
        Set = function(self, newOptions)
            if not newOptions then newOptions = self end
            options = newOptions
            populate(options)
        end,
        Get = function() return current end,
    }
end

