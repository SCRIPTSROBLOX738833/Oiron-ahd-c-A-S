        Size = UDim2.new(0, 9, 0, 9),
        Position = UDim2.new(0.5, 1, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Image = Icons.play,
        ImageColor3 = C.White,
        Parent = arrowBg
    })

    btn.MouseEnter:Connect(function()
        Tween(btn, { BackgroundColor3 = C.White }, 0.15)
        Tween(labelLbl, { TextColor3 = C.Black }, 0.15)
        Tween(st, { Color = C.Black }, 0.15)
        for _, c in ipairs(btn:GetChildren()) do
            if c:IsA("ImageLabel") and c.Parent == btn then Tween(c, { ImageColor3 = C.Black }, 0.15) end
        end
        Tween(arrowSt, { Color = C.Black }, 0.15)
